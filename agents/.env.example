# Copy to .env and fill in values. Never commit real keys.

# Gemini API (Google AI Studio) — used by most labs
GOOGLE_API_KEY=your_api_key_here

# Optional: use Vertex AI instead of AI Studio
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Default model for labs (override per agent if needed)
# Examples: gemini-flash-latest, gemini-2.0-flash, gemini-2.5-flash
ADK_MODEL=gemini-flash-latest

# Module 17 — Vertex / Agent Runtime (optional)
# AGENT_ENGINE_ID=
# REASONING_ENGINE_APP_NAME=
# STAGING_BUCKET=gs://your-project-adk-staging
